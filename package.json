{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:bosses": "tsx scripts/bossCodexCheck.ts",
    "check:agent": "tsx scripts/bossAgentSim.ts",
    "check:map": "tsx scripts/mapCheck.ts",
    "check:nav": "tsx scripts/mapAgentSim.ts",
    "check:all": "tsx scripts/guardianCheck.ts && tsx scripts/bossCodexCheck.ts && tsx scripts/mapCheck.ts && tsx scripts/selfFixCheck.ts && tsx scripts/metroidEscortCheck.ts && tsx scripts/bossAgentSim.ts && tsx scripts/mapAgentSim.ts",
    "check:selffix": "tsx scripts/selfFixCheck.ts",
    "check:escort": "tsx scripts/metroidEscortCheck.ts",
    "check:guardian": "tsx scripts/guardianCheck.ts",
    "check:playtest": "GAME_MINUTES=5 SNAPSHOT_EVERY=0 OUT_DIR=playtest/out3 tsx playtest/aiPlaytest.ts && node playtest/analyze.mjs playtest/out3"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
